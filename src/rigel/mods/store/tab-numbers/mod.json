          "value": "badge",
          "label": "Rozet"
        },
        {
          "value": "plain",
          "label": "Sade sayı"
        },
        {
          "value": "corner",
          "label": "Simge köşesinde"
        }
      ]
    },
    {
      "key": "color",
      "label": "Renk",
      "type": "dropdown",
      "default": "accent",
      "options": [
        {
          "value": "accent",
          "label": "Vurgu tonu"
        },
        {
          "value": "solid",
          "label": "Dolu vurgu"
        },
        {
          "value": "dim",
          "label": "Soluk"
        }
      ]
    }
  ],
