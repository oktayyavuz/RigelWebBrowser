      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "Simge ve ad"
        },
        {
          "value": "icons",
          "label": "Yalnız simge"
        },
        {
          "value": "names",
          "label": "Yalnız ad"
        }
      ]
    },
    {
      "key": "autohide",
      "label": "Gizle, üstüne gelince aç",
      "type": "checkbox",
      "default": false
    }
  ]
}