{
  "name": "Yer imi çubuğu",
  "description": "Rigel'in yer imi çubuğunu (Ctrl+Shift+B ile aç/kapat) biçimlendirir: hap biçimli düğmeler, ortalama, yalnız simge ya da yalnız ad, ve yer kaplamadan üstüne gelince açılma.",
  "author": "n7itro",
  "version": "1.1.0",
  "target": "chrome",
  "homepage": "https://github.com/zen-browser/theme-store/tree/main/themes/ea1a5ace-f698-4b45-ab88-6e8bd3a563f0",
  "license": "MIT",
