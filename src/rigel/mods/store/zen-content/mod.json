{
  "name": "Yüzen sayfa",
  "description": "Web sayfası kenarlardan boşluklu, yuvarlak köşeli, gölgeli bir kart olarak yüzer (Zen/Arc hissi); arkası arayüz renginde dolar. Köşe yarıçapı, kenar boşluğu ve gölge gücü kaydırıcıyla, çerçeve rengi renk seçiciyle ayarlanır. Bütün düzenlerde çalışır.",
  "author": "Rigel",
  "version": "3.0.0",
  "target": "chrome",
  "prefs": [
    {
      "key": "radius",
      "label": "Köşe yarıçapı",
      "type": "range",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "key": "gap",
      "label": "Kenar boşluğu",
      "type": "range",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "key": "shadow",
      "label": "Gölge gücü",
      "type": "range",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "",
      "default": 60
    },
    {
      "key": "frame",
      "label": "Çerçeve rengi",
      "type": "color",
      "default": "#1c2030"
    },
    {
      "key": "custom-frame",
      "label": "Özel çerçeve rengini kullan",
      "type": "checkbox",
      "default": false
    },
    {
      "key": "glow",
      "label": "Arkada vurgu ışıltısı",
      "type": "checkbox",
      "default": true
    }
  ],
  "license": "MPL-2.0",
  "category": "duzen",
  "summary": "Sayfa boşluklu, yuvarlak köşeli, gölgeli bir kart olur",
  "conflicts": [
    "private-highlight"
  ]
}
