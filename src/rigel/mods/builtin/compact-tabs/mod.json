{
  "name": "Kompakt sekme satırları",
  "description": "Sekme satırlarının yüksekliğini, yazı boyutunu ve aralığını kaydırıcılarla daraltır ya da genişletir: yan panel dikey sekmeleri, Klasik şeridi ve sekme paneli.",
  "author": "Rigel",
  "version": "2.0.0",
  "target": "chrome",
  "prefs": [
    {
      "key": "density",
      "label": "Satır yüksekliği",
      "type": "range",
      "min": 18,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "key": "font-size",
      "label": "Yazı boyutu",
      "type": "range",
      "min": 9,
      "max": 16,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "key": "gap",
      "label": "Sekmeler arası boşluk",
      "type": "range",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}