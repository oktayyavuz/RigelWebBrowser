# Maintainer: Oktay Yavuz <oktayyavuz220@gmail.com>
#
# Rigel: Firefox tabanlı, Zen'den esinli web tarayıcısı.
# Mozilla'nın resmî Türkçe Firefox ikilisi (değiştirilmeden, sha256 sabit) + Rigel arayüzü (GitHub sürüm etiketi).
# Firefox /opt/rigel/app altına kurulur; sistemdeki Firefox'a dokunulmaz. Profil: ~/.local/share/rigel/profile.

pkgname=rigel-browser-bin
pkgver=0.1.0
pkgrel=1
_ffver=158.0.1
pkgdesc='Firefox tabanlı, Zen tarzı web tarayıcısı (Türkçe arayüz)'
arch=('x86_64')
url='https://github.com/oktayyavuz/rigeldesktop'
license=('MPL-2.0' 'MIT')
provides=('rigel-browser')
conflicts=('rigel-browser')
depends=('alsa-lib' 'dbus' 'ffmpeg' 'gtk3' 'libxt' 'mime-types' 'nss' 'ttf-font')
optdepends=(
  'libnotify: masaüstü bildirimleri'
  'libva: donanım video çözme (VA-API)'
  'pulseaudio: ses (PulseAudio/PipeWire-pulse)'
  'speech-dispatcher: metin okuma'
  'xdg-desktop-portal: dosya seçici, ekran paylaşımı'
  'networkmanager: ağ durumu algılama'
  'hunspell-tr: Türkçe yazım denetimi'
)
options=('!strip' '!debug')
source=("rigeldesktop-${pkgver}.tar.gz::https://github.com/oktayyavuz/rigeldesktop/archive/refs/tags/v${pkgver}.tar.gz"
        "firefox-${_ffver}.tar.xz::https://archive.mozilla.org/pub/firefox/releases/${_ffver}/linux-x86_64/tr/firefox-${_ffver}.tar.xz")
sha256sums=('babf544afa43ab98de52f4c3a6c3858d2fe3fb730f97825cb9185e551e1edf95'
            '3de87bf6ad8b2b12371f79a61301eb7cc1a14072de96eff787c1fd01f220d305')

_src="rigeldesktop-${pkgver}"

prepare() {
  local v; v="$(tr -d '[:space:]' < "$_src/FIREFOX_VERSION")"
  if [[ $v != "$_ffver" ]]; then
    error "FIREFOX_VERSION ($v) ile _ffver ($_ffver) farklı; PKGBUILD güncellenmeli."
    return 1
  fi
}

package() {
  local _src="$srcdir/$_src"
  local app="$pkgdir/opt/rigel/app" s n stamp tpl

  # Firefox (Mozilla'nın ikilisi, değiştirilmeden)
  install -dm755 "$pkgdir/opt/rigel"
  cp -a "$srcdir/firefox" "$app"

  # Rigel katmanı: fx-autoconfig, ilkeler, varsayılan tercihler, pencere ikonları
  install -Dm644 "$_src/vendor/fx-autoconfig/program/config.js" "$app/config.js"
  install -Dm644 "$_src/vendor/fx-autoconfig/program/defaults/pref/config-prefs.js" "$app/defaults/pref/config-prefs.js"
  install -Dm644 "$_src/distribution/policies.json" "$app/distribution/policies.json"
  install -Dm644 "$_src/prefs/rigel.js" "$app/browser/defaults/preferences/rigel.js"
  # Oturum geri yükleme: çıplak "app/firefox" çağrısı /usr/bin/rigel'e yönlenir (packaging/linux/firefox-wrapper.sh)
  install -Dm755 "$_src/packaging/linux/firefox-wrapper.sh" "$app/firefox"
  for s in "$_src"/src/rigel/branding/content/icon*.png; do
    n="$(basename "$s" .png)"; n="${n#icon}"
    [[ $n =~ ^[0-9]+$ ]] && install -Dm644 "$s" "$app/browser/chrome/icons/default/default$n.png"
  done

  # Rigel dosyaları ve fx-autoconfig yükleyicisi (profilin chrome/JS ve chrome/utils bağlantıları buraya gösterir)
  cp -a "$_src/src/rigel" "$pkgdir/opt/rigel/rigel"
  cp -a "$_src/vendor/fx-autoconfig/profile/chrome/utils" "$pkgdir/opt/rigel/utils"
  stamp="$(cd "$_src" && { find src/rigel prefs distribution -type f -print0 | sort -z | xargs -0 sha256sum; } | sha256sum | cut -c1-12)"
  printf '%s-%s\n' "$pkgver" "$stamp" > "$pkgdir/opt/rigel/VERSION"
  chmod -R go-w,a+rX "$pkgdir/opt/rigel"

  # Başlatıcı: uygulama /opt/rigel altında, profil kullanıcının ~/.local/share/rigel/profile klasöründe
  tpl="$(<"$_src/packaging/linux/rigel.sh.in")"
  tpl="${tpl//'@RIGEL_HOME@'/'/opt/rigel'}"
  tpl="${tpl//'@PROFILE_DEFAULT@'/'${XDG_DATA_HOME:-$HOME/.local/share}/rigel/profile'}"
  install -dm755 "$pkgdir/usr/bin"
  printf '%s\n' "$tpl" > "$pkgdir/usr/bin/rigel"
  chmod 755 "$pkgdir/usr/bin/rigel"

  # Masaüstü girdisi ve ikonlar
  tpl="$(<"$_src/packaging/linux/rigel.desktop")"
  printf '%s\n' "${tpl//'@RIGEL_RUN@'/'/usr/bin/rigel'}" > "$srcdir/rigel.desktop"
  install -Dm644 "$srcdir/rigel.desktop" "$pkgdir/usr/share/applications/rigel.desktop"
  for s in 16 32 48 64 128; do
    install -Dm644 "$_src/src/rigel/branding/content/icon$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/rigel.png"
  done
  install -Dm644 "$_src/design/logo.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/rigel.png"
  install -Dm644 "$_src/design/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/rigel.svg"

  # Lisanslar
  install -Dm644 "$_src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_src/vendor/fx-autoconfig/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.fx-autoconfig"
}
