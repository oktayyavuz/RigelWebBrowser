# Maintainer: Oktay Yavuz <oktayyavuz220@gmail.com>
#
# Rigel: Firefox tabanlı, Zen'den esinli kişisel tarayıcı.
# Bu PKGBUILD depodan çalıştırılır (kaynak dosyalar ../.. altındadır):
#
#   gh repo clone oktayyavuz/rigeldesktop && cd rigeldesktop/packaging/arch
#   makepkg -si
#
# Firefox, Mozilla'nın resmî Türkçe x86_64 arşivinden indirilir (sha256 aşağıda sabitlenmiştir) ve
# /opt/rigel/app altına kurulur; sistemdeki Firefox'a dokunulmaz. Profil: ~/.local/share/rigel/profile.
# FIREFOX_VERSION (depoda) değiştiğinde _ffver ve sha256sums burada da güncellenmelidir.

_repo="${RIGEL_SRC:-$(cd "$startdir/../.." && pwd)}"

pkgname=rigel-browser
pkgver="$(tr -d '[:space:]' < "$_repo/VERSION")"
pkgrel=1
_ffver=158.0.1
pkgdesc='Rigel: Firefox tabanlı, Zen tarzı kişisel web tarayıcısı (Mozilla Firefox ikilisi + Rigel arayüzü)'
arch=('x86_64')
url='https://github.com/oktayyavuz/rigeldesktop'
license=('MPL-2.0')
depends=(
  'alsa-lib'
  'dbus'
  'ffmpeg'          # H.264/AAC/AV1 çözme (YouTube, anime siteleri)
  'gtk3'
  'libxt'
  'mime-types'
  'nss'
  'ttf-font'
)
optdepends=(
  'libnotify: masaüstü bildirimleri'
  'libva: donanım video çözme (VA-API)'
  'pulseaudio: ses (PulseAudio/PipeWire-pulse)'
  'speech-dispatcher: metin okuma'
  'xdg-desktop-portal: dosya seçici, ekran paylaşımı'
  'networkmanager: ağ durumu algılama'
  'hunspell-tr: Türkçe yazım denetimi'
)
options=('!strip' '!debug')
source=("firefox-${_ffver}.tar.xz::https://archive.mozilla.org/pub/firefox/releases/${_ffver}/linux-x86_64/tr/firefox-${_ffver}.tar.xz")
# https://archive.mozilla.org/pub/firefox/releases/158.0.1/SHA256SUMS (linux-x86_64/tr/firefox-158.0.1.tar.xz)
sha256sums=('3de87bf6ad8b2b12371f79a61301eb7cc1a14072de96eff787c1fd01f220d305')
noextract=()

prepare() {
  local v; v="$(tr -d '[:space:]' < "$_repo/FIREFOX_VERSION")"
  if [[ $v != "$_ffver" ]]; then
    error "FIREFOX_VERSION ($v) ile PKGBUILD _ffver ($_ffver) farklı; _ffver ve sha256sums güncelleyin."
    return 1
  fi
}

package() {
  local app="$pkgdir/opt/rigel/app" s n stamp tpl

  # Firefox (Mozilla'nın ikilisi, değiştirilmeden)
  install -dm755 "$pkgdir/opt/rigel"
  cp -a "$srcdir/firefox" "$app"

  # Rigel katmanı: fx-autoconfig, ilkeler, varsayılan tercihler, pencere ikonları
  install -Dm644 "$_repo/vendor/fx-autoconfig/program/config.js" "$app/config.js"
  install -Dm644 "$_repo/vendor/fx-autoconfig/program/defaults/pref/config-prefs.js" "$app/defaults/pref/config-prefs.js"
  install -Dm644 "$_repo/distribution/policies.json" "$app/distribution/policies.json"
  install -Dm644 "$_repo/prefs/rigel.js" "$app/browser/defaults/preferences/rigel.js"
  for s in "$_repo"/src/rigel/branding/content/icon*.png; do
    n="$(basename "$s" .png)"; n="${n#icon}"
    [[ $n =~ ^[0-9]+$ ]] && install -Dm644 "$s" "$app/browser/chrome/icons/default/default$n.png"
  done

  # Rigel dosyaları ve fx-autoconfig yükleyicisi (profilin chrome/JS ve chrome/utils bağlantıları buraya gösterir)
  cp -a "$_repo/src/rigel" "$pkgdir/opt/rigel/rigel"
  cp -a "$_repo/vendor/fx-autoconfig/profile/chrome/utils" "$pkgdir/opt/rigel/utils"
  stamp="$(cd "$_repo" && { find src/rigel prefs distribution -type f -print0 | sort -z | xargs -0 sha256sum; } | sha256sum | cut -c1-12)"
  printf '%s-%s\n' "$pkgver" "$stamp" > "$pkgdir/opt/rigel/VERSION"
  chmod -R go-w,a+rX "$pkgdir/opt/rigel"

  # Başlatıcı: uygulama /opt/rigel altında, profil kullanıcının ~/.local/share/rigel/profile klasöründe
  tpl="$(<"$_repo/packaging/linux/rigel.sh.in")"
  tpl="${tpl//'@RIGEL_HOME@'/'/opt/rigel'}"
  tpl="${tpl//'@PROFILE_DEFAULT@'/'${XDG_DATA_HOME:-$HOME/.local/share}/rigel/profile'}"
  install -dm755 "$pkgdir/usr/bin"
  printf '%s\n' "$tpl" > "$pkgdir/usr/bin/rigel"
  chmod 755 "$pkgdir/usr/bin/rigel"

  # Masaüstü girdisi ve ikonlar
  tpl="$(<"$_repo/packaging/linux/rigel.desktop")"
  printf '%s\n' "${tpl//'@RIGEL_RUN@'/'/usr/bin/rigel'}" > "$srcdir/rigel.desktop"
  install -Dm644 "$srcdir/rigel.desktop" "$pkgdir/usr/share/applications/rigel.desktop"
  for s in 16 32 48 64 128; do
    install -Dm644 "$_repo/src/rigel/branding/content/icon$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/rigel.png"
  done
  install -Dm644 "$_repo/design/logo.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/rigel.png"
  install -Dm644 "$_repo/design/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/rigel.svg"

  # Lisanslar
  install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_repo/vendor/fx-autoconfig/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.fx-autoconfig"
}
